                "operationId": "suggestProducts",
                "parameters": [
                    {
                        "name": "product_id",
                        "in": "query",
                        "description": "Source product id",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/v1/catalog/products/stats": {
            "get": {
                "tags": [
                    "Module 2 - Search Optimization"
                ],
                "summary": "Search / product stats",
                "description": "Return simple statistics useful for search analytics or caching (e.g. total products).",
                "operationId": "productSearchStats",
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },

                                            "type": "integer"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/v1/catalog/products/suggest": {
            "get": {
                "tags": [
                    "Module 2 - Search Optimization"
                ],
                "summary": "Suggest related products",

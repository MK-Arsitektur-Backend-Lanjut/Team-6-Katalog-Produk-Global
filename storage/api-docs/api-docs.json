{
    "openapi": "3.0.0",
    "info": {
        "title": "Katalog Produk Global API",
        "description": "Dokumentasi API untuk Modul 1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/v1/catalog/categories/tree": {
            "get": {
                "tags": [
                    "Module 1 - Catalog Metadata"
                ],
                "summary": "Get category hierarchy tree",
                "description": "Returns all categories in a nested tree structure (cached)",
                "operationId": "getCategoryTree",
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/v1/catalog/categories/{slug}": {
            "get": {
                "tags": [
                    "Module 1 - Catalog Metadata"
                ],
                "summary": "Get category detail by slug",
                "description": "Returns the category details",
                "operationId": "getCategoryBySlug",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Category Slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Category not found"
                    }
                }
            }
        },
        "/api/v1/catalog/categories/{slug}/breadcrumbs": {
            "get": {
                "tags": [
                    "Module 1 - Catalog Metadata"
                ],
                "summary": "Get breadcrumbs for a category",
                "description": "Returns an array of categories representing the path from root to this category",
                "operationId": "getCategoryBreadcrumbs",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Category Slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Category not found"
                    }
                }
            }
        },
        "/api/v1/catalog/products": {
            "get": {
                "tags": [
                    "Module 1 - Catalog Metadata"
                ],
                "summary": "Get all active products (offset pagination)",
                "description": "Returns paginated active products list. Max 10000 items per page. Results are cached in Redis.",
                "operationId": "getProducts",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page (max 10000)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/v1/catalog/products/cursor": {
            "get": {
                "tags": [
                    "Public Products"
                ],
                "summary": "Get all active products (cursor pagination)",
                "description": "Cursor-based pagination — efficient for iterating large datasets (10,000+ products). Does not use OFFSET so performance is constant across all pages.",
                "operationId": "getProductsCursor",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page (max 10000)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 100
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "description": "Cursor from previous response",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/v1/catalog/products/{slug}": {
            "get": {
                "tags": [
                    "Module 1 - Catalog Metadata"
                ],
                "summary": "Get product detail by slug",
                "description": "Returns full product detail snapshot",
                "operationId": "getProductBySlug",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Product Slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Product not found"
                    }
                }
            }
        },
        "/api/v1/catalog/products/id/{id}": {
            "get": {
                "tags": [
                    "Module 1 - Catalog Metadata"
                ],
                "summary": "Get product detail by ID",
                "description": "Returns full product detail snapshot",
                "operationId": "getProductById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Product not found"
                    }
                }
            }
        },
        "/api/v1/catalog/products/search": {
            "get": {
                "tags": [
                    "Module 2 - Search Optimization"
                ],
                "summary": "Search products with filters, sorting and pagination",
                "description": "Search products using keyword, category, price/rating filters, sorting and pagination.",
                "operationId": "searchProducts",
                "parameters": [
                    {
                        "name": "keyword",
                        "in": "query",
                        "description": "Search keyword",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "smartphone"
                        }
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "Filter by category id (will include descendants)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    },
                    {
                        "name": "min_price",
                        "in": "query",
                        "description": "Minimum price filter (in IDR)",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float",
                            "example": 100000
                        }
                    },
                    {
                        "name": "max_price",
                        "in": "query",
                        "description": "Maximum price filter (in IDR)",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float",
                            "example": 500000
                        }
                    },
                    {
                        "name": "min_rating",
                        "in": "query",
                        "description": "Minimum average rating filter (0-5)",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float",
                            "example": 4
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort order (price_asc, price_desc, rating_desc, latest)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "price_desc"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Items per page (max 100)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 10,
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 123
                                                    },
                                                    "sku": {
                                                        "type": "string",
                                                        "example": "SKU-001"
                                                    },
                                                    "slug": {
                                                        "type": "string",
                                                        "example": "produk-sku-001"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "LG Product uQXQG - 1"
                                                    },
                                                    "short_description": {
                                                        "type": "string",
                                                        "example": "Short description here"
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "example": "Full description here"
                                                    },
                                                    "price": {
                                                        "type": "number",
                                                        "format": "float",
                                                        "example": 4780000
                                                    },
                                                    "rating_avg": {
                                                        "type": "number",
                                                        "format": "float",
                                                        "example": 4.2
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "example": "active"
                                                    },
                                                    "metadata_version": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2026-04-15T12:00:00Z"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2026-04-15T12:00:00Z"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "example": 10
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "example": 10000
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "example": 1000
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                },
                                "example": {
                                    "data": [
                                        {
                                            "id": 123,
                                            "sku": "SKU-001",
                                            "slug": "produk-sku-001",
                                            "name": "LG Product uQXQG - 1",
                                            "short_description": "Short description here",
                                            "description": "Full description here",
                                            "price": 4780000,
                                            "rating_avg": 4.2,
                                            "status": "active",
                                            "metadata_version": 1,
                                            "created_at": "2026-04-15T12:00:00Z",
                                            "updated_at": "2026-04-15T12:00:00Z"
                                        }
                                    ],
                                    "meta": {
                                        "current_page": 1,
                                        "per_page": 10,
                                        "total": 10000,
                                        "last_page": 1000
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/catalog/products/autocomplete": {
            "get": {
                "tags": [
                    "Module 2 - Search Optimization"
                ],
                "summary": "Autocomplete product names",
                "description": "Return product suggestions for autocomplete (id, name, slug) based on prefix match.",
                "operationId": "autocompleteProducts",
                "parameters": [
                    {
                        "name": "query",
                        "in": "query",

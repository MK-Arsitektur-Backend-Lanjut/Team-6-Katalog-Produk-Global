                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/v1/catalog/products/facets": {
            "get": {
                "tags": [
                    "Module 2 - Search Optimization"
                ],
                "summary": "Get facets for search UI (category counts, price ranges)",
